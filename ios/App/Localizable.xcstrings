    "Bir dahakine kendiliğinden uyanması için PS5'te: Ayarlar > Sistem > Güç Tasarrufu > Dinlenme Modunda Kullanılabilen Özellikler > Ağdan PS5'i Açmayı Etkinleştir.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لكي يستيقظ تلقائيًا في المرة القادمة، على PS5: Settings > System > Power Saving > Features Available in Rest Mode > Enable Turning On PS5 from Network."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Aby se příště probudila sama, na PS5: Settings > System > Power Saving > Features Available in Rest Mode > Enable Turning On PS5 from Network."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Για να ξυπνά μόνη της την επόμενη φορά, στο PS5: Settings > System > Power Saving > Features Available in Rest Mode > Enable Turning On PS5 from Network."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To let it wake up on its own next time, on the PS5: Settings > System > Power Saving > Features Available in Rest Mode > Enable Turning On PS5 from Network."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अगली बार अपने आप जागने के लिए PS5 पर: Settings > System > Power Saving > Features Available in Rest Mode > Enable Turning On PS5 from Network."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Hogy legközelebb magától felébredjen, a PS5-ön: Settings > System > Power Saving > Features Available in Rest Mode > Enable Turning On PS5 from Network."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Agar lain kali bisa bangun sendiri, di PS5: Settings > System > Power Saving > Features Available in Rest Mode > Enable Turning On PS5 from Network."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zodat hij de volgende keer zelf wakker wordt, op de PS5: Settings > System > Power Saving > Features Available in Rest Mode > Enable Turning On PS5 from Network."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Aby sa nabudúce zobudila sama, na PS5: Settings > System > Power Saving > Features Available in Rest Mode > Enable Turning On PS5 from Network."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "För att den ska vakna av sig själv nästa gång, på PS5: Settings > System > Power Saving > Features Available in Rest Mode > Enable Turning On PS5 from Network."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เพื่อให้ตื่นเองในครั้งหน้า บน PS5: Settings > System > Power Saving > Features Available in Rest Mode > Enable Turning On PS5 from Network"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Щоб наступного разу консоль прокидалася сама, на PS5: Settings > System > Power Saving > Features Available in Rest Mode > Enable Turning On PS5 from Network."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Để lần sau máy tự thức dậy, trên PS5: Settings > System > Power Saving > Features Available in Rest Mode > Enable Turning On PS5 from Network."
          }
        }
      }
    },
