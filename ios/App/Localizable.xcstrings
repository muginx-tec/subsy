    "ŞU AN OKUNAN": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُقرأ الآن"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "PRÁVĚ ČTENO"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "ΔΙΑΒΑΖΕΤΑΙ ΤΩΡΑ"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "READING NOW"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अभी पढ़ा जा रहा है"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "MOST OLVASOTT"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "SEDANG DIBACA"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "NU GELEZEN"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "PRÁVE ČÍTANÉ"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "LÄSES NU"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กำลังอ่าน"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "ЗАРАЗ ЧИТАЄТЬСЯ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "ĐANG ĐỌC"
          }
        }
      }
    },
    "Şimdilik yalnız PS5 ve PS4 destekleniyor; Xbox desteklenmiyor.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حاليًا ندعم PS5 وPS4 فقط؛ Xbox غير مدعوم."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zatím podporujeme jen PS5 a PS4; Xbox podporovaný není."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Προς το παρόν υποστηρίζονται μόνο PS5 και PS4· το Xbox δεν υποστηρίζεται."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only PS5 and PS4 are supported for now; Xbox isn't supported."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अभी सिर्फ़ PS5 और PS4 सपोर्टेड हैं; Xbox सपोर्टेड नहीं है।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Egyelőre csak a PS5 és a PS4 támogatott; az Xbox nem."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Saat ini hanya PS5 dan PS4 yang didukung; Xbox belum didukung."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voorlopig worden alleen PS5 en PS4 ondersteund; Xbox niet."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zatiaľ podporujeme len PS5 a PS4; Xbox podporovaný nie je."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Just nu stöds bara PS5 och PS4; Xbox stöds inte."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตอนนี้รองรับเฉพาะ PS5 และ PS4 ยังไม่รองรับ Xbox"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Наразі підтримуються лише PS5 і PS4; Xbox не підтримується."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiện chỉ hỗ trợ PS5 và PS4; chưa hỗ trợ Xbox."
          }
        }
      }
    },
    "“Konsola Bağla”ya bas. Bağlanınca “Altyazıyı aç”a dokun: altyazı tam ekran gelir. Telefonu yatay koy, yanında dursun.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط «اتصل بالجهاز». بعد الاتصال اضغط «افتح الترجمة» فتملأ الترجمة الشاشة. ضع الهاتف أفقيًا بجانبك."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Klepni na „Připojit konzoli“. Po připojení klepni na „Otevřít titulky“: titulky zaplní obrazovku. Polož telefon na šířku vedle sebe."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πάτησε «Σύνδεση με κονσόλα». Μόλις συνδεθεί, πάτησε «Άνοιγμα υποτίτλων»: οι υπότιτλοι γεμίζουν την οθόνη. Βάλε το τηλέφωνο οριζόντια δίπλα σου."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap “Connect to Console”. Once connected, tap “Open subtitles”: subtitles fill the screen. Put your phone in landscape beside you."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "“कंसोल से जोड़ें” दबाएँ। कनेक्ट होने पर “सबटाइटल खोलें” टैप करें: सबटाइटल पूरी स्क्रीन पर आएँगे। फ़ोन को आड़ा करके पास में रखें।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Koppints a „Csatlakozás a konzolhoz” gombra. Csatlakozás után koppints a „Feliratok megnyitása” gombra: a felirat kitölti a képernyőt. Tedd magad mellé a telefont fektetve."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketuk “Hubungkan ke Konsol”. Setelah terhubung, ketuk “Buka subtitle”: subtitle tampil layar penuh. Letakkan ponsel mendatar di sampingmu."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik op “Verbind met console”. Tik na het verbinden op “Ondertitels openen”: de ondertitels vullen het scherm. Leg je telefoon liggend naast je."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ťukni na „Pripojiť konzolu“. Po pripojení ťukni na „Otvoriť titulky“: titulky zaplnia obrazovku. Polož telefón na šírku vedľa seba."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryck på ”Anslut till konsol”. När du är ansluten trycker du på ”Öppna undertexter”: undertexterna fyller skärmen. Lägg telefonen liggande bredvid dig."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แตะ “เชื่อมต่อคอนโซล” เมื่อเชื่อมต่อแล้วแตะ “เปิดซับไตเติล” ซับไตเติลจะขึ้นเต็มจอ วางโทรศัพท์แนวนอนไว้ข้างตัว"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Натисніть «Підключити консоль». Після підключення торкніться «Відкрити субтитри»: субтитри з'являться на весь екран. Покладіть телефон горизонтально поруч."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chạm “Kết nối máy chơi game”. Khi đã kết nối, chạm “Mở phụ đề”: phụ đề hiện toàn màn hình. Đặt điện thoại nằm ngang bên cạnh bạn."
          }
        }
      }
    }
  },
  "version": "1.0"
}