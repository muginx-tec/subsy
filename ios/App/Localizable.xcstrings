    "Apple'ın telefon çevirisi senin dilini desteklemiyor. Bu dilde altyazı için Subsy Pro gerekir.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ترجمة Apple على الهاتف لا تدعم لغتك. للترجمة بهذه اللغة تحتاج إلى Subsy Pro."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Překlad Apple v telefonu tvůj jazyk nepodporuje. Pro titulky v tomto jazyce potřebuješ Subsy Pro."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η μετάφραση της Apple στο τηλέφωνο δεν υποστηρίζει τη γλώσσα σου. Για υπότιτλους σε αυτή τη γλώσσα χρειάζεσαι το Subsy Pro."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple's on-device translation doesn't support your language. Subtitles in this language need Subsy Pro."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple का फ़ोन वाला अनुवाद आपकी भाषा को सपोर्ट नहीं करता। इस भाषा में सबटाइटल के लिए Subsy Pro चाहिए।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az Apple telefonos fordítása nem támogatja a nyelvedet. Ezen a nyelven a feliratokhoz Subsy Pro kell."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Terjemahan bawaan Apple di ponsel tidak mendukung bahasamu. Subtitle dalam bahasa ini butuh Subsy Pro."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De vertaling van Apple op je telefoon ondersteunt jouw taal niet. Voor ondertitels in deze taal heb je Subsy Pro nodig."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Preklad Apple v telefóne tvoj jazyk nepodporuje. Na titulky v tomto jazyku potrebuješ Subsy Pro."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Apples översättning i telefonen stöder inte ditt språk. För undertexter på det här språket behöver du Subsy Pro."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การแปลในเครื่องของ Apple ไม่รองรับภาษาของคุณ ต้องใช้ Subsy Pro เพื่อดูซับไตเติลภาษานี้"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Переклад Apple на телефоні не підтримує твою мову. Для субтитрів цією мовою потрібен Subsy Pro."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bản dịch trên điện thoại của Apple không hỗ trợ ngôn ngữ của bạn. Phụ đề bằng ngôn ngữ này cần Subsy Pro."
          }
        }
      }
    },
