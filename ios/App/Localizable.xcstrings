    "Bağlantı koptu. Konsol sekmesinden yeniden bağlan.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انقطع الاتصال. أعد الاتصال من تبويب الجهاز."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Spojení se přerušilo. Připoj se znovu na kartě Konzole."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η σύνδεση χάθηκε. Σύνδεσε ξανά από την καρτέλα Κονσόλα."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connection lost. Reconnect from the Console tab."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कनेक्शन टूट गया। कंसोल टैब से फिर से कनेक्ट करें।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Megszakadt a kapcsolat. Csatlakozz újra a Konzol fülön."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Koneksi terputus. Sambungkan lagi dari tab Konsol."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbinding verbroken. Maak opnieuw verbinding via het tabblad Console."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Spojenie sa prerušilo. Pripoj sa znova na karte Konzola."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Anslutningen bröts. Anslut igen från fliken Konsol."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การเชื่อมต่อขาดหาย เชื่อมต่อใหม่จากแท็บคอนโซล"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "З'єднання втрачено. Підключись знову на вкладці «Консоль»."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mất kết nối. Hãy kết nối lại từ thẻ Máy chơi game."
          }
        }
      }
    },
    "Bağlantı olmazsa kendiliğinden telefonun çevirisine döner.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إذا انقطع الاتصال تعود تلقائيًا إلى ترجمة الهاتف."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Při výpadku spojení se sám vrátí k překladu v telefonu."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αν χαθεί η σύνδεση, γυρίζει μόνη της στη μετάφραση του τηλεφώνου."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Falls back to on-device translation if the connection drops."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कनेक्शन न हो तो अपने आप फ़ोन के अनुवाद पर लौट आता है।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ha megszakad a kapcsolat, magától visszavált a telefonos fordításra."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jika koneksi putus, otomatis kembali ke terjemahan ponsel."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Valt bij een verbroken verbinding vanzelf terug op vertalen op de telefoon."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pri výpadku spojenia sa sám vráti k prekladu v telefóne."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Går automatiskt tillbaka till telefonens översättning om anslutningen bryts."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หากการเชื่อมต่อขาด จะกลับไปใช้การแปลบนโทรศัพท์เอง"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Якщо зв'язку немає, сам повертається до перекладу на телефоні."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nếu mất kết nối sẽ tự chuyển về dịch trên điện thoại."
          }
        }
      }
    },
