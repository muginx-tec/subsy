    "Konsola yeniden bağlanıyor...": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "جارٍ إعادة الاتصال بالجهاز..."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Znovu se připojuji ke konzoli..."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επανασύνδεση με την κονσόλα..."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reconnecting to the console..."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कंसोल से फिर से जुड़ रहा है..."
          }
        },
        "hu": {
