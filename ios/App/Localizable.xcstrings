    "(kutuda yazı yok)": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "(لا يوجد نص في المربع)"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "(v rámečku není text)"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "(δεν υπάρχει κείμενο στο πλαίσιο)"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "(no text in the box)"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "(बॉक्स में कोई टेक्स्ट नहीं)"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "(nincs szöveg a keretben)"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "(tidak ada teks di kotak)"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "(geen tekst in het kader)"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "(v rámčeku nie je text)"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "(ingen text i rutan)"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "(ไม่มีข้อความในกรอบ)"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "(у рамці немає тексту)"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "(không có chữ trong khung)"
          }
        }
      }
    },
    "1 saatlik Pro yalnız Instagram'da paylaşınca verilir.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُمنح ساعة Pro المجانية فقط عند المشاركة على Instagram."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Hodinu Pro zdarma dostaneš jen za sdílení na Instagramu."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η δωρεάν ώρα Pro δίνεται μόνο για κοινοποίηση στο Instagram."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The free hour of Pro is given only for sharing on Instagram."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "1 घंटे का मुफ़्त Pro सिर्फ़ Instagram पर शेयर करने पर मिलता है।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az ingyenes Pro órát csak instagramos megosztásért adjuk."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro gratis 1 jam hanya diberikan jika kamu membagikan di Instagram."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het gratis uur Pro krijg je alleen als je op Instagram deelt."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Hodinu Pro zadarmo dostaneš len za zdieľanie na Instagrame."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den gratis Pro-timmen ges bara när du delar på Instagram."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro ฟรี 1 ชั่วโมงจะได้รับเฉพาะเมื่อแชร์บน Instagram เท่านั้น"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Безкоштовну годину Pro можна отримати лише за допис в Instagram."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "1 giờ Pro miễn phí chỉ được tặng khi chia sẻ trên Instagram."
          }
        }
      }
    },
