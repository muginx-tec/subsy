    "İnternet gerekmez, telefonun içinde çalışır.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا تحتاج إلى إنترنت وتعمل داخل هاتفك."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Bez internetu, běží přímo v telefonu."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν χρειάζεται ίντερνετ, τρέχει μέσα στο τηλέφωνο."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No internet needed; runs on your phone."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इंटरनेट नहीं चाहिए, फ़ोन के अंदर चलता है।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nem kell internet, a telefonban fut."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tanpa internet, berjalan di dalam ponselmu."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen internet nodig; werkt op je telefoon."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Bez internetu, beží priamo v telefóne."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inget internet behövs; körs i telefonen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่ต้องใช้อินเทอร์เน็ต ทำงานในโทรศัพท์"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Інтернет не потрібен, працює в телефоні."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không cần internet, chạy ngay trong điện thoại."
          }
        }
      }
    },
    "İnternet ister, yaklaşık 1 saniye sürer.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحتاج إلى إنترنت وتستغرق نحو ثانية واحدة."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyžaduje internet, trvá asi 1 sekundu."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Χρειάζεται ίντερνετ, διαρκεί περίπου 1 δευτερόλεπτο."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Needs internet; takes about 1 second."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इंटरनेट चाहिए, लगभग 1 सेकंड लगता है।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Internet kell hozzá, kb. 1 másodperc."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Butuh internet, sekitar 1 detik."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Internet nodig; duurt ongeveer 1 seconde."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyžaduje internet, trvá asi 1 sekundu."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kräver internet; tar cirka 1 sekund."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ต้องใช้อินเทอร์เน็ต ใช้เวลาประมาณ 1 วินาที"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Потрібен інтернет, триває близько 1 секунди."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cần internet, mất khoảng 1 giây."
          }
        }
