    "Gerçek oyunda yaptığımız testte, telefon çevirisine göre.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "في اختبارنا على لعب حقيقي، مقارنةً بالترجمة على الجهاز."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "V našem testu na skutečném hraní, ve srovnání s překladem v zařízení."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Στη δοκιμή μας σε πραγματικό παιχνίδι, σε σύγκριση με τη μετάφραση στη συσκευή."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In our test on real gameplay, compared with on-device translation."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "असली गेमप्ले पर हमारे परीक्षण में, डिवाइस पर अनुवाद की तुलना में।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Valódi játékon végzett tesztünkben, a készüléken futó fordításhoz képest."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Dalam uji kami pada gameplay nyata, dibanding terjemahan di perangkat."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "In onze test met echte gameplay, vergeleken met vertalen op het toestel."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "V našom teste na skutočnom hraní, v porovnaní s prekladom v zariadení."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "I vårt test med riktigt spelande, jämfört med översättning på enheten."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "จากการทดสอบของเรากับการเล่นเกมจริง เทียบกับการแปลบนเครื่อง"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "У нашому тесті на реальній грі, порівняно з перекладом на пристрої."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trong thử nghiệm của chúng tôi khi chơi thật, so với dịch trên thiết bị."
          }
        }
      }
    },
    "Geç": {
