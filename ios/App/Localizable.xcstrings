      }
    },
    "Oyunun altyazı ayarlarından yazı arka planını ve konuşan adlarını açarsan çeviriler çok daha isabetli olur.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فعّل خلفية النص وأسماء المتحدثين من إعدادات الترجمة في اللعبة، وستصبح الترجمة أدق بكثير."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapni v nastavení titulků ve hře pozadí textu a jména mluvčích, překlady budou mnohem přesnější."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ενεργοποίησε το φόντο κειμένου και τα ονόματα ομιλητών στις ρυθμίσεις υποτίτλων του παιχνιδιού και οι μεταφράσεις θα γίνουν πολύ πιο ακριβείς."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn on the subtitle background and speaker names in your game's subtitle settings, and translations get much more accurate."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "गेम की सबटाइटल सेटिंग में टेक्स्ट बैकग्राउंड और बोलने वाले का नाम चालू कर दें, अनुवाद कहीं ज़्यादा सटीक हो जाएगा।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kapcsold be a játék feliratbeállításaiban a szöveg hátterét és a beszélők nevét, így a fordítás sokkal pontosabb lesz."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktifkan latar belakang teks dan nama pembicara di pengaturan subtitle game, terjemahan akan jauh lebih akurat."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zet de tekstachtergrond en sprekersnamen aan in de ondertitelinstellingen van je game, dan worden vertalingen veel nauwkeuriger."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapni v nastaveniach titulkov v hre pozadie textu a mená hovoriacich, preklady budú oveľa presnejšie."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Slå på textbakgrund och talarnamn i spelets undertextinställningar, så blir översättningarna mycket mer träffsäkra."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปิดพื้นหลังข้อความและชื่อผู้พูดในการตั้งค่าคำบรรยายของเกม แล้วคำแปลจะแม่นยำขึ้นมาก"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Увімкніть тло тексту та імена мовців у налаштуваннях субтитрів гри, і переклад стане значно точнішим."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy bật nền chữ và tên người nói trong cài đặt phụ đề của game, bản dịch sẽ chính xác hơn nhiều."
          }
        }
      }
    },
    "Oyunun ayarlarından İngilizce altyazıyı aç. Uygulama ekrandaki o altyazıyı okuyup çevirir; altyazı kapalıysa çevirecek bir şey bulamaz.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "من إعدادات اللعبة فعّل الترجمة النصية بالإنجليزية. التطبيق يقرأ ذلك النص من الشاشة ويترجمه، وإن كان مغلقًا فلن يجد ما يترجمه."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "V nastavení hry zapni anglické titulky. Aplikace je čte z obrazovky a překládá; bez titulků není co překládat."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Στις ρυθμίσεις του παιχνιδιού άνοιξε τους αγγλικούς υπότιτλους. Η εφαρμογή τους διαβάζει από την οθόνη και τους μεταφράζει· αν είναι κλειστοί, δεν υπάρχει κάτι να μεταφράσει."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn on English subtitles in the game's settings. The app reads those subtitles on screen and translates them; with subtitles off there is nothing to translate."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "गेम की सेटिंग्स में अंग्रेज़ी सबटाइटल चालू करें। ऐप स्क्रीन पर वही सबटाइटल पढ़कर अनुवाद करता है; सबटाइटल बंद हो तो अनुवाद के लिए कुछ नहीं मिलता।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A játék beállításaiban kapcsold be az angol feliratot. Az alkalmazás ezt olvassa le a képernyőről és fordítja; felirat nélkül nincs mit fordítani."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Nyalakan subtitle bahasa Inggris di pengaturan game. Aplikasi membaca subtitle itu di layar lalu menerjemahkannya; jika subtitle mati, tidak ada yang bisa diterjemahkan."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zet in de game-instellingen de Engelse ondertitels aan. De app leest die ondertitels op het scherm en vertaalt ze; zonder ondertitels valt er niets te vertalen."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "V nastaveniach hry zapni anglické titulky. Aplikácia ich číta z obrazovky a prekladá; bez titulkov nie je čo prekladať."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Slå på engelska undertexter i spelets inställningar. Appen läser dem på skärmen och översätter; utan undertexter finns inget att översätta."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปิดซับไตเติลภาษาอังกฤษในการตั้งค่าของเกม แอปจะอ่านซับไตเติลนั้นบนจอแล้วแปล ถ้าปิดซับไตเติลจะไม่มีอะไรให้แปล"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "У налаштуваннях гри ввімкніть англійські субтитри. Застосунок читає їх з екрана й перекладає; якщо субтитри вимкнено, перекладати нічого."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bật phụ đề tiếng Anh trong cài đặt của game. Ứng dụng đọc phụ đề đó trên màn hình rồi dịch; nếu tắt phụ đề thì không có gì để dịch."
          }
        }
      }
    },
    "Oyununu TV'den, kendi kumandanla oyna. Telefonu yanına koy; altyazı çıktıkça çevirisi ekrana gelir.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "العب على التلفاز بيد التحكم الخاصة بك. ضع الهاتف بجانبك، وستظهر الترجمة كلما ظهر نص في اللعبة."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Hraj na televizi vlastním ovladačem. Telefon si polož vedle sebe; překlad se objeví vždy, když se ukážou titulky."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Παίξε στην τηλεόραση με το δικό σου χειριστήριο. Βάλε το τηλέφωνο δίπλα σου· η μετάφραση εμφανίζεται μόλις βγουν υπότιτλοι."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Play on your TV with your own controller. Keep your phone next to you; translations appear as subtitles come up."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "गेम TV पर अपने कंट्रोलर से खेलें। फ़ोन पास में रखें; सबटाइटल आते ही उसका अनुवाद दिखेगा।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Játssz a tévén a saját kontrollereddel. Tedd magad mellé a telefont; a fordítás megjelenik, amint felirat érkezik."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mainkan game di TV dengan controller-mu sendiri. Letakkan ponsel di sampingmu; terjemahan muncul setiap ada subtitle."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Speel op je tv met je eigen controller. Leg je telefoon naast je; de vertaling verschijnt zodra er ondertitels zijn."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Hraj na televízore vlastným ovládačom. Telefón si polož vedľa seba; preklad sa objaví vždy, keď sa ukážu titulky."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Spela på tv:n med din egen handkontroll. Lägg telefonen bredvid dig; översättningen visas så fort undertexter dyker upp."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เล่นเกมบนทีวีด้วยคอนโทรลเลอร์ของคุณเอง วางโทรศัพท์ไว้ข้างตัว คำแปลจะขึ้นทุกครั้งที่มีซับไตเติล"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Грайте на телевізорі власним контролером. Покладіть телефон поруч; переклад з'являтиметься разом із субтитрами."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chơi game trên TV bằng tay cầm của bạn. Đặt điện thoại bên cạnh; bản dịch hiện ra mỗi khi có phụ đề."
          }
        }
      }
    },
    "PS4'te Ayarlar > Uzaktan Oynama Bağlantı Ayarları > Cihaz Ekle ekranını aç. Çıkan 8 haneli kodu buraya yaz.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "في PS4 افتح Settings > Remote Play Connection Settings > Add Device. اكتب هنا الرمز المكوّن من 8 أرقام."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Na PS4 otevři Settings > Remote Play Connection Settings > Add Device. Sem zadej 8místný kód."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Στο PS4 άνοιξε Settings > Remote Play Connection Settings > Add Device. Γράψε εδώ τον 8ψήφιο κωδικό."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On your PS4, open Settings > Remote Play Connection Settings > Add Device. Enter the 8-digit code here."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "PS4 पर Settings > Remote Play Connection Settings > Add Device खोलें। 8 अंकों का कोड यहाँ लिखें।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A PS4-en nyisd meg: Settings > Remote Play Connection Settings > Add Device. Írd ide a 8 jegyű kódot."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Di PS4, buka Settings > Remote Play Connection Settings > Add Device. Masukkan kode 8 digit di sini."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Open op je PS4 Settings > Remote Play Connection Settings > Add Device. Vul hier de 8-cijferige code in."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Na PS4 otvor Settings > Remote Play Connection Settings > Add Device. Sem zadaj 8-miestny kód."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Öppna Settings > Remote Play Connection Settings > Add Device på din PS4. Skriv den 8-siffriga koden här."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บน PS4 เปิด Settings > Remote Play Connection Settings > Add Device แล้วพิมพ์รหัส 8 หลักที่นี่"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "На PS4 відкрийте Settings > Remote Play Connection Settings > Add Device. Введіть тут 8-значний код."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trên PS4, mở Settings > Remote Play Connection Settings > Add Device. Nhập mã 8 chữ số vào đây."
          }
        }
      }
    },
    "PS5 açık olmalı. Dinlenme modundaysa: Ayarlar > Sistem > Güç Tasarrufu > Dinlenme Modunda Kullanılabilen Özellikler > İnternete Bağlı Kal.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يجب أن يكون PS5 قيد التشغيل. إذا كان في وضع الراحة: Settings > System > Power Saving > Features Available in Rest Mode > Stay Connected to the Internet."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5 musí být zapnutá. Pokud je v klidovém režimu: Settings > System > Power Saving > Features Available in Rest Mode > Stay Connected to the Internet."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το PS5 πρέπει να είναι ανοιχτό. Αν είναι σε λειτουργία ηρεμίας: Settings > System > Power Saving > Features Available in Rest Mode > Stay Connected to the Internet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5 must be on. If it's in rest mode: Settings > System > Power Saving > Features Available in Rest Mode > Stay Connected to the Internet."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5 चालू होना चाहिए। अगर रेस्ट मोड में है: Settings > System > Power Saving > Features Available in Rest Mode > Stay Connected to the Internet."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A PS5 legyen bekapcsolva. Ha nyugalmi módban van: Settings > System > Power Saving > Features Available in Rest Mode > Stay Connected to the Internet."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5 harus menyala. Jika dalam mode istirahat: Settings > System > Power Saving > Features Available in Rest Mode > Stay Connected to the Internet."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De PS5 moet aanstaan. Staat hij in rustmodus: Settings > System > Power Saving > Features Available in Rest Mode > Stay Connected to the Internet."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5 musí byť zapnutá. Ak je v pokojovom režime: Settings > System > Power Saving > Features Available in Rest Mode > Stay Connected to the Internet."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5 måste vara på. Om den är i viloläge: Settings > System > Power Saving > Features Available in Rest Mode > Stay Connected to the Internet."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5 ต้องเปิดอยู่ หากอยู่ในโหมดพัก: Settings > System > Power Saving > Features Available in Rest Mode > Stay Connected to the Internet."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5 має бути увімкнена. Якщо вона в режимі спокою: Settings > System > Power Saving > Features Available in Rest Mode > Stay Connected to the Internet."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5 phải đang bật. Nếu đang ở chế độ nghỉ: Settings > System > Power Saving > Features Available in Rest Mode > Stay Connected to the Internet."
          }
        }
      }
    },
    "PS5 bağlı değil": {
      "localizations": {
        "ar": {
          "stringUnit": {
