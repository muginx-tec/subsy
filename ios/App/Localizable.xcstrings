    "Adlar ve terimler oyun boyunca hep aynı çevrilir.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُترجم الأسماء والمصطلحات بالطريقة نفسها طوال اللعبة."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jména a pojmy se překládají stejně po celou hru."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ονόματα και όροι μεταφράζονται ίδια σε όλο το παιχνίδι."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Names and terms are translated the same way throughout the game."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "नाम और शब्द पूरे गेम में एक जैसे अनुवाद होते हैं।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A nevek és kifejezések az egész játékban ugyanúgy fordulnak."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Nama dan istilah diterjemahkan sama sepanjang game."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Namen en termen worden de hele game hetzelfde vertaald."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Mená a pojmy sa prekladajú rovnako počas celej hry."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Namn och termer översätts likadant genom hela spelet."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ชื่อและคำศัพท์จะแปลเหมือนเดิมตลอดทั้งเกม"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Імена й терміни перекладаються однаково протягом усієї гри."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tên và thuật ngữ được dịch giống nhau suốt game."
          }
        }
      }
    },
