    "PS5 ve PS4 desteklenir. Konsol kabloyla, telefon Wi-Fi ile aynı modeme bağlıysa da olur.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يدعم PS5 و PS4. ويعمل أيضًا إذا كان الجهاز موصولًا بكابل والهاتف على Wi-Fi من الموجّه نفسه."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Podporovány jsou PS5 i PS4. Funguje i tehdy, když je konzole připojena kabelem a telefon přes Wi-Fi stejného routeru."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Υποστηρίζονται PS5 και PS4. Δουλεύει και όταν η κονσόλα είναι με καλώδιο και το τηλέφωνο στο Wi-Fi του ίδιου ρούτερ."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5 and PS4 are supported. It also works if the console is wired and the phone is on Wi-Fi from the same router."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5 और PS4 सपोर्ट हैं। कंसोल केबल से और फ़ोन उसी राउटर के Wi-Fi से जुड़ा हो तो भी चलता है।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A PS5 és a PS4 támogatott. Akkor is működik, ha a konzol kábelen, a telefon pedig ugyanannak a routernek a Wi-Fi-jén van."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5 dan PS4 didukung. Juga bisa jika konsol memakai kabel dan ponsel memakai Wi-Fi dari router yang sama."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5 en PS4 worden ondersteund. Het werkt ook als de console bekabeld is en de telefoon via wifi op dezelfde router zit."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Podporované sú PS5 aj PS4. Funguje aj vtedy, keď je konzola pripojená káblom a telefón cez Wi-Fi toho istého routera."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5 och PS4 stöds. Det fungerar också om konsolen är kabelansluten och telefonen går via Wi-Fi på samma router."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รองรับ PS5 และ PS4 ใช้ได้เช่นกันถ้าคอนโซลต่อสายและโทรศัพท์ใช้ Wi-Fi จากเราเตอร์เดียวกัน"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Підтримуються PS5 і PS4. Працює і тоді, коли консоль підключена кабелем, а телефон через Wi-Fi того самого роутера."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hỗ trợ PS5 và PS4. Vẫn dùng được nếu máy chơi game nối dây và điện thoại dùng Wi-Fi của cùng bộ định tuyến."
          }
        }
      }
    },
    "PS5 veya PS4'ünü bul ve çeviriyi başlat.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اعثر على PS5 أو PS4 وابدأ الترجمة."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Najdi svou PS5 nebo PS4 a začni překládat."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Βρες το PS5 ή το PS4 σου και ξεκίνα τη μετάφραση."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Find your PS5 or PS4 and start translating."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपना PS5 या PS4 ढूँढें और अनुवाद शुरू करें।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Keresd meg a PS5-öd vagy PS4-ed, és kezdd a fordítást."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Temukan PS5 atau PS4-mu dan mulai menerjemahkan."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vind je PS5 of PS4 en begin met vertalen."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Nájdi svoju PS5 alebo PS4 a začni prekladať."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Hitta din PS5 eller PS4 och börja översätta."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ค้นหา PS5 หรือ PS4 ของคุณแล้วเริ่มแปล"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Знайдіть свою PS5 або PS4 і почніть переклад."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tìm PS5 hoặc PS4 của bạn và bắt đầu dịch."
          }
        }
      }
    },
    "PS5'te Ayarlar > Sistem > Uzaktan Oynama > Cihaz Bağla ekranını aç. Çıkan 8 haneli kodu buraya yaz.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "في PS5 افتح Settings > System > Remote Play > Link Device. اكتب هنا الرمز المكوّن من 8 أرقام."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Na PS5 otevři Settings > System > Remote Play > Link Device. Sem zadej 8místný kód."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Στο PS5 άνοιξε Settings > System > Remote Play > Link Device. Γράψε εδώ τον 8ψήφιο κωδικό."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On your PS5, open Settings > System > Remote Play > Link Device. Enter the 8-digit code here."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "PS5 पर Settings > System > Remote Play > Link Device खोलें। 8 अंकों का कोड यहाँ लिखें।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A PS5-ön nyisd meg: Settings > System > Remote Play > Link Device. Írd ide a 8 jegyű kódot."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Di PS5, buka Settings > System > Remote Play > Link Device. Masukkan kode 8 digit di sini."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Open op je PS5 Settings > System > Remote Play > Link Device. Vul hier de 8-cijferige code in."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Na PS5 otvor Settings > System > Remote Play > Link Device. Sem zadaj 8-miestny kód."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Öppna Settings > System > Remote Play > Link Device på din PS5. Skriv den 8-siffriga koden här."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บน PS5 เปิด Settings > System > Remote Play > Link Device แล้วพิมพ์รหัส 8 หลักที่นี่"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "На PS5 відкрийте Settings > System > Remote Play > Link Device. Введіть тут 8-значний код."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trên PS5, mở Settings > System > Remote Play > Link Device. Nhập mã 8 chữ số vào đây."
          }
        }
      }
    },
    "PS5'te Ayarlar › Sistem › Uzaktan Oynama › Cihaz Bağla ekranını aç, çıkan 8 haneli kodu uygulamaya yaz.": {
