    "Deneme hakkını kullandın.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لقد استخدمت تجربتك من قبل."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zkušební dobu jsi už využil."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Έχεις ήδη χρησιμοποιήσει τη δοκιμή σου."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You've already used your trial."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आप अपना ट्रायल पहले ही इस्तेमाल कर चुके हैं।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A próbaidődet már felhasználtad."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamu sudah memakai uji cobamu."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je hebt je proefperiode al gebruikt."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Skúšobnú dobu si už využil."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du har redan använt din provperiod."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณใช้สิทธิ์ทดลองไปแล้ว"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ви вже використали пробний період."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn đã dùng lượt dùng thử rồi."
          }
        }
      }
    },
    "Deneme süresi bitiyor:": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تنتهي التجربة في:"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zkušební doba končí v:"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η δοκιμή λήγει στις:"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Trial ends at:"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ट्रायल खत्म होगा:"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A próbaidő vége:"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Uji coba berakhir pukul:"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Proef eindigt om:"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Skúšobná doba končí o:"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Provperioden slutar:"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สิ้นสุดการทดลองเวลา:"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Пробний період закінчується о:"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dùng thử kết thúc lúc:"
          }
        }
      }
    },
    "Deneme verilemedi. İnternet bağlantını kontrol et.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر بدء التجربة. تحقّق من اتصالك بالإنترنت."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zkušební dobu se nepodařilo spustit. Zkontroluj připojení k internetu."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η δοκιμή δεν ξεκίνησε. Έλεγξε τη σύνδεσή σου στο ίντερνετ."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't start the trial. Check your internet connection."
          }
        },
