    "Pro denemen başladı: 1 saat yapay zekâ çevirisi senin.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بدأت تجربة Pro: ساعة من الترجمة بالذكاء الاصطناعي لك."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zkušební Pro začal: 1 hodina překladu pomocí AI je tvoje."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η δοκιμή Pro ξεκίνησε: 1 ώρα μετάφρασης με AI για σένα."
          }
