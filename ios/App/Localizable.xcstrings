    "Yazı boyunu alttaki A− / A+ ile ayarlarsın. Yukarı kaydırınca eski replikleri okursun.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "غيّر حجم الخط من A− / A+ في الأسفل. مرّر للأعلى لقراءة الجمل السابقة."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Velikost textu měníš tlačítky A− / A+ dole. Posunem nahoru si přečteš starší repliky."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Άλλαξε το μέγεθος του κειμένου με τα A− / A+ κάτω. Κύλησε προς τα πάνω για τις προηγούμενες ατάκες."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Adjust text size with A− / A+ at the bottom. Scroll up to read earlier lines."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "टेक्स्ट का आकार नीचे A− / A+ से बदलें। पुराने संवाद पढ़ने के लिए ऊपर स्क्रॉल करें।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A betűméretet alul az A− / A+ gombokkal állítod. Felfelé görgetve a korábbi sorokat olvashatod."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Atur ukuran teks dengan A− / A+ di bawah. Gulir ke atas untuk membaca dialog sebelumnya."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas de tekstgrootte aan met A− / A+ onderaan. Scrol omhoog om eerdere regels te lezen."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Veľkosť textu meníš tlačidlami A− / A+ dole. Posunom nahor si prečítaš staršie repliky."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ändra textstorlek med A− / A+ längst ner. Rulla uppåt för att läsa tidigare repliker."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ปรับขนาดตัวอักษรด้วย A− / A+ ด้านล่าง เลื่อนขึ้นเพื่ออ่านบทพูดก่อนหน้า"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Розмір тексту змінюйте кнопками A− / A+ внизу. Гортайте вгору, щоб прочитати попередні репліки."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉnh cỡ chữ bằng A− / A+ ở dưới. Cuộn lên để đọc các câu trước."
          }
        }
      }
    },
