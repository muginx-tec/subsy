    "Önceki replikleri de görerek çevirir: özne, deyim ve argo yerine oturur.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تقرأ الجمل السابقة أيضًا، فتصيب في الضمائر والتعابير والعامية."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Čte i předchozí repliky: podmět, idiomy a slang sedí."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Διαβάζει και τις προηγούμενες ατάκες: υποκείμενο, ιδιωματισμοί και αργκό βγαίνουν σωστά."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reads the previous lines too: subjects, idioms and slang come out right."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पिछले संवाद भी देखकर अनुवाद करता है: कर्ता, मुहावरे और बोलचाल सही बैठते हैं।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az előző sorokat is látja: az alany, a szólások és a szleng a helyére kerül."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ikut membaca dialog sebelumnya: subjek, idiom, dan bahasa gaul jadi tepat."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Leest ook de vorige regels mee: onderwerp, uitdrukkingen en straattaal kloppen."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Číta aj predchádzajúce repliky: podmet, idiómy a slang sedia."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Läser även tidigare repliker: subjekt, idiom och slang blir rätt."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อ่านบทพูดก่อนหน้าด้วย ทำให้ประธาน สำนวน และคำแสลงถูกต้อง"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Читає й попередні репліки: підмет, ідіоми та сленг стають на місце."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đọc cả các câu trước đó: chủ ngữ, thành ngữ và tiếng lóng đều đúng chỗ."
          }
        }
      }
    },
    "Önceki replikleri okur; kimin kime konuştuğunu ve özneyi doğru çevirir.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تقرأ الجمل السابقة فتصيب في من يخاطب من وفي الضمائر."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Čte předchozí repliky; správně pozná, kdo ke komu mluví, a přeloží podmět."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Διαβάζει τις προηγούμενες ατάκες· αποδίδει σωστά ποιος μιλάει σε ποιον και το υποκείμενο."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reads the previous lines; gets who is talking to whom and the subject right."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पिछले संवाद पढ़ता है; कौन किससे बोल रहा है और कर्ता सही अनुवाद करता है।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Olvassa az előző sorokat; jól adja vissza, ki kihez beszél, és az alanyt."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Membaca dialog sebelumnya; tepat soal siapa bicara ke siapa dan subjeknya."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Leest de vorige regels; weet wie tegen wie praat en vertaalt het onderwerp goed."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Číta predchádzajúce repliky; správne spozná, kto ku komu hovorí, a preloží podmet."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Läser tidigare repliker; får rätt på vem som talar till vem och på subjektet."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อ่านบทพูดก่อนหน้า ทำให้รู้ว่าใครพูดกับใครและแปลประธานถูกต้อง"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Читає попередні репліки; правильно передає, хто до кого говорить, і підмет."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đọc các câu trước; dịch đúng ai nói với ai và đúng chủ ngữ."
          }
        }
      }
    },
    "Örnek: uydurma replikler, çeviri gerçek": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مثال: سطور مختلقة وترجمة حقيقية"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ukázka: smyšlené repliky, skutečný překlad"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Παράδειγμα: φανταστικές ατάκες, πραγματική μετάφραση"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sample: made-up lines, real translation"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "नमूना: काल्पनिक संवाद, असली अनुवाद"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Minta: kitalált mondatok, valódi fordítás"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Contoh: dialog karangan, terjemahan asli"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voorbeeld: verzonnen regels, echte vertaling"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ukážka: vymyslené repliky, skutočný preklad"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Exempel: påhittade repliker, riktig översättning"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตัวอย่าง: บทพูดสมมติ แปลจริง"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Приклад: вигадані репліки, справжній переклад"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mẫu: câu thoại giả định, bản dịch thật"
          }
        }
      }
    },
    "Ücretsiz": {
      "localizations": {
        "ar": {
          "stringUnit": {
