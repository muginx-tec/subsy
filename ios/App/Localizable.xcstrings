    "Pro'da çeviriyi yapay zekâ yapar: sahneyi anlar, replikler gerçek bir konuşma gibi okunur.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "في Pro يتولى الذكاء الاصطناعي الترجمة: يفهم المشهد فتُقرأ الجمل كأنها حوار حقيقي."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "V Pro překládá AI: rozumí scéně, takže repliky zní jako skutečný rozhovor."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Στο Pro μεταφράζει η AI: καταλαβαίνει τη σκηνή, κι έτσι οι ατάκες διαβάζονται σαν πραγματική κουβέντα."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In Pro, AI does the translating: it follows the scene, so lines read like real conversation."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro में अनुवाद AI करता है: वह दृश्य को समझता है, इसलिए संवाद असली बातचीत जैसे पढ़े जाते हैं।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Pro-ban az AI fordít: érti a jelenetet, így a sorok valódi beszélgetésként olvashatók."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Di Pro, AI yang menerjemahkan: ia memahami adegannya, sehingga dialog terbaca seperti percakapan sungguhan."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "In Pro vertaalt AI: het volgt de scène, zodat regels lezen als een echt gesprek."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "V Pro prekladá AI: rozumie scéne, takže repliky znejú ako skutočný rozhovor."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "I Pro översätter AI: den förstår scenen, så replikerna läses som ett riktigt samtal."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใน Pro นั้น AI เป็นผู้แปล: เข้าใจฉากที่เกิดขึ้น บทพูดจึงอ่านเหมือนบทสนทนาจริง"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "У Pro перекладає ШІ: він розуміє сцену, тож репліки читаються як справжня розмова."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Với Pro, AI đảm nhận việc dịch: hiểu được cảnh đang diễn ra nên lời thoại đọc như cuộc trò chuyện thật."
          }
        }
      }
    },
    "Satın alma tamamlanamadı.": {
