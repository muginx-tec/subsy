    "Sokak ağzını ve deyimleri kelime kelime değil, anlamıyla çevirir.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تترجم لغة الشارع والتعابير بمعناها لا كلمة بكلمة."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Překládá pouliční mluvu a idiomy podle významu, ne slovo od slova."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μεταφράζει την αργκό και τους ιδιωματισμούς με το νόημά τους, όχι λέξη προς λέξη."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Translates street talk and idioms by meaning, not word for word."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सड़क की भाषा और मुहावरों का शब्द-दर-शब्द नहीं, अर्थ के अनुसार अनुवाद करता है।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az utcai nyelvet és a szólásokat jelentés szerint fordítja, nem szóról szóra."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menerjemahkan bahasa jalanan dan idiom sesuai maknanya, bukan kata per kata."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vertaalt straattaal en uitdrukkingen naar betekenis, niet woord voor woord."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Prekladá pouličnú reč a idiómy podľa významu, nie slovo po slove."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Översätter gatuspråk och idiom efter betydelse, inte ord för ord."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แปลภาษาพูดและสำนวนตามความหมาย ไม่ใช่แปลทีละคำ"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перекладає вуличну мову та ідіоми за змістом, а не дослівно."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dịch tiếng đường phố và thành ngữ theo nghĩa, không dịch từng chữ."
          }
        }
      }
    },
