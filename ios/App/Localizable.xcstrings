          }
        }
      }
    },
    "Pro henüz satışta değil. Yapay zekâ çevirisi şimdilik herkese açık.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro غير متاح للبيع بعد. الترجمة بالذكاء الاصطناعي متاحة للجميع حاليًا."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro se zatím neprodává. Překlad pomocí AI je prozatím otevřený všem."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το Pro δεν πωλείται ακόμη. Η μετάφραση με AI είναι προς το παρόν ανοιχτή σε όλους."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro isn't on sale yet. AI translation is open to everyone for now."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro अभी बिक्री में नहीं है। AI अनुवाद फ़िलहाल सबके लिए खुला है।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Pro még nem kapható. Az AI-fordítás egyelőre mindenkinek elérhető."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro belum dijual. Terjemahan AI untuk sementara terbuka bagi semua."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro is nog niet te koop. AI-vertaling is voorlopig voor iedereen beschikbaar."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro sa zatiaľ nepredáva. Preklad pomocou AI je zatiaľ otvorený pre všetkých."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro säljs inte än. AI-översättning är tills vidare öppen för alla."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro ยังไม่เปิดขาย ตอนนี้การแปลด้วย AI เปิดให้ทุกคนใช้"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro ще не продається. Переклад ШІ поки що відкритий для всіх."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro chưa được bán. Hiện tại dịch bằng AI mở cho tất cả mọi người."
          }
        }
      }
    },
    "Pro ile neler gelir": {
