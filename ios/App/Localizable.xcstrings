        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Nama dan istilah khusus game selalu diterjemahkan sama."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Namen en termen uit de game worden altijd hetzelfde vertaald."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
