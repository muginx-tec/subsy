    "Varsayılana dön": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إعادة للوضع الافتراضي"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Obnovit výchozí"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επαναφορά προεπιλογής"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reset to default"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "डिफ़ॉल्ट पर लौटें"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Alaphelyzet"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kembali ke bawaan"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Standaard herstellen"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Obnoviť predvolené"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Återställ standard"
          }
        },
        "th": {
          "stringUnit": {
