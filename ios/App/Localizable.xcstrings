    "Oyuna özel adlar ve terimler hep aynı çevrilir.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أسماء اللعبة ومصطلحاتها تُترجم دائمًا بالطريقة نفسها."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jména a pojmy ze hry se překládají vždy stejně."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ονόματα και όροι του παιχνιδιού μεταφράζονται πάντα με τον ίδιο τρόπο."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Game-specific names and terms are always translated the same way."
          }
        },
        "hi": {
          "stringUnit": {
