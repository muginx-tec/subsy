    "Fiyatlar yüklenemedi. İnternet bağlantını kontrol et.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر تحميل الأسعار. تحقّق من اتصالك بالإنترنت."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ceny se nepodařilo načíst. Zkontroluj připojení k internetu."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν ήταν δυνατή η φόρτωση των τιμών. Έλεγξε τη σύνδεσή σου στο internet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't load prices. Check your internet connection."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कीमतें लोड नहीं हो सकीं। अपना इंटरनेट कनेक्शन जाँचें।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nem sikerült betölteni az árakat. Ellenőrizd az internetkapcsolatot."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Gagal memuat harga. Periksa koneksi internet kamu."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Prijzen konden niet worden geladen. Controleer je internetverbinding."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ceny sa nepodarilo načítať. Skontroluj pripojenie na internet."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det gick inte att läsa in priserna. Kontrollera din internetanslutning."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โหลดราคาไม่สำเร็จ ตรวจสอบการเชื่อมต่ออินเทอร์เน็ต"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося завантажити ціни. Перевір підключення до інтернету."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không tải được giá. Hãy kiểm tra kết nối internet."
          }
        }
      }
    },
    "Fiyatlar yükleniyor...": {
      "localizations": {
