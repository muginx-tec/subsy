          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je Pro-proef is begonnen: 1 uur AI-vertaling voor jou."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Skúšobné Pro sa začalo: 1 hodina prekladu pomocou AI je tvoja."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Din Pro-provperiod har startat: 1 timme AI-översättning är din."
          }
        },
        "th": {
          "stringUnit": {
