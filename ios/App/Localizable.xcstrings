    "Giriş Sony'nin kendi sayfasında yapılır. Parolan bu uygulamaya gelmez, hiçbir yere gönderilmez.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تسجيل الدخول يتم في صفحة Sony نفسها. كلمة مرورك لا تصل إلى هذا التطبيق ولا تُرسل إلى أي مكان."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přihlášení probíhá na stránce samotné Sony. Tvoje heslo se do této aplikace nedostane a nikam se neposílá."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η σύνδεση γίνεται στη σελίδα της ίδιας της Sony. Ο κωδικός σου δεν φτάνει σε αυτή την εφαρμογή και δεν στέλνεται πουθενά."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You sign in on Sony's own page. Your password never reaches this app and is not sent anywhere."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "साइन इन Sony के अपने पेज पर होता है। आपका पासवर्ड इस ऐप तक नहीं आता और कहीं नहीं भेजा जाता।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A bejelentkezés a Sony saját oldalán történik. A jelszavad nem jut el ehhez az alkalmazáshoz, és sehová sem kerül elküldésre."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamu masuk di halaman Sony sendiri. Kata sandimu tidak sampai ke aplikasi ini dan tidak dikirim ke mana pun."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je logt in op de eigen pagina van Sony. Je wachtwoord komt niet bij deze app en wordt nergens heen gestuurd."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Prihlásenie prebieha na stránke samotnej Sony. Tvoje heslo sa do tejto aplikácie nedostane a nikam sa neposiela."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du loggar in på Sonys egen sida. Ditt lösenord når aldrig den här appen och skickas ingenstans."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การลงชื่อเข้าใช้ทำในหน้าเว็บของ Sony เอง รหัสผ่านของคุณไม่ถูกส่งมาที่แอปนี้และไม่ถูกส่งไปที่ใด"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вхід відбувається на сторінці самої Sony. Ваш пароль не потрапляє до цього застосунку й нікуди не надсилається."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn đăng nhập trên trang của chính Sony. Mật khẩu không đến ứng dụng này và không được gửi đi đâu."
          }
        }
      }
    },
    "Giriş olmadı, yeniden dene.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فشل تسجيل الدخول، حاول مرة أخرى."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přihlášení se nezdařilo, zkus to znovu."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η σύνδεση απέτυχε, δοκίμασε ξανά."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign-in failed, please try again."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "साइन इन नहीं हुआ, फिर से कोशिश करें।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A bejelentkezés nem sikerült, próbáld újra."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Gagal masuk, coba lagi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Inloggen mislukt, probeer het opnieuw."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Prihlásenie zlyhalo, skús to znova."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inloggningen misslyckades, försök igen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เข้าสู่ระบบไม่สำเร็จ ลองอีกครั้ง"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося увійти, спробуй ще раз."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đăng nhập không thành công, hãy thử lại."
          }
        }
      }
    },
