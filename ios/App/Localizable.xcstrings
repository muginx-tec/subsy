    "Telefon bu dili çeviremiyor. Ayarlar'dan yapay zekâyı seç.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هاتفك لا يستطيع ترجمة هذه اللغة. اختر الذكاء الاصطناعي من الإعدادات."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Telefon tento jazyk přeložit neumí. V Nastavení zvol AI."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το τηλέφωνό σου δεν μπορεί να μεταφράσει αυτή τη γλώσσα. Διάλεξε AI στις Ρυθμίσεις."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your phone can't translate this language. Choose AI in Settings."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका फ़ोन इस भाषा का अनुवाद नहीं कर सकता। सेटिंग्स में AI चुनें।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A telefonod ezt a nyelvet nem tudja fordítani. A Beállításokban válaszd az AI-t."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ponselmu tidak bisa menerjemahkan bahasa ini. Pilih AI di Pengaturan."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je telefoon kan deze taal niet vertalen. Kies AI in Instellingen."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Telefón tento jazyk preložiť nevie. V Nastaveniach zvoľ AI."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Din telefon kan inte översätta det här språket. Välj AI i Inställningar."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โทรศัพท์ของคุณแปลภาษานี้ไม่ได้ เลือก AI ในการตั้งค่า"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Телефон не може перекладати цією мовою. Виберіть ШІ в налаштуваннях."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Điện thoại không dịch được ngôn ngữ này. Hãy chọn AI trong Cài đặt."
          }
        }
      }
    },
    "Telefon ve konsol aynı Wi-Fi ağında olmalı (misafir ağı ya da mobil veri olmaz).": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يجب أن يكون الهاتف والجهاز على شبكة Wi-Fi نفسها (ليست شبكة ضيوف ولا بيانات الجوال)."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Telefon a konzole musí být ve stejné síti Wi-Fi (ne v síti pro hosty ani na mobilních datech)."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το τηλέφωνο και η κονσόλα πρέπει να είναι στο ίδιο δίκτυο Wi-Fi (όχι δίκτυο επισκεπτών ή δεδομένα κινητής)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your phone and console must be on the same Wi-Fi network (not a guest network or mobile data)."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फ़ोन और कंसोल एक ही Wi-Fi नेटवर्क पर होने चाहिए (गेस्ट नेटवर्क या मोबाइल डेटा नहीं)।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A telefon és a konzol ugyanazon a Wi-Fi-hálózaton legyen (ne vendéghálózaton vagy mobilneten)."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ponsel dan konsol harus di jaringan Wi-Fi yang sama (bukan jaringan tamu atau data seluler)."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je telefoon en console moeten op hetzelfde wifinetwerk zitten (geen gastnetwerk of mobiele data)."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Telefón a konzola musia byť v rovnakej sieti Wi-Fi (nie v sieti pre hostí ani na mobilných dátach)."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Telefonen och konsolen måste vara på samma wifi-nätverk (inte gästnätverk eller mobildata)."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โทรศัพท์และคอนโซลต้องอยู่ในเครือข่าย Wi-Fi เดียวกัน (ไม่ใช่เครือข่ายแขกหรือเน็ตมือถือ)"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Телефон і консоль мають бути в одній мережі Wi-Fi (не гостьова мережа і не мобільний інтернет)."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Điện thoại và máy phải cùng một mạng Wi-Fi (không phải mạng khách hay dữ liệu di động)."
          }
        }
      }
    },
