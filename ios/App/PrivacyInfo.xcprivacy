<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Subsy kullanıcıyı izlemez (izleme izni istenmez, reklam kimliği toplanmaz). Meta SDK yalnız kurulum ve
	     açılış olayını reklam ölçümü için gönderir; kendi gizlilik bildirimi SDK'nın içinde gelir. -->
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>
	<!-- Toplanan veri beyanı App Store Connect'teki gizlilik anketinde yapılır (magaza/GIZLILIK_BEYANI.md). -->
	<key>NSPrivacyCollectedDataTypes</key>
	<array/>
	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<dict>
			<!-- Uygulamanın kendi ayarları (dil, kutu yeri, yazı boyu) için UserDefaults. -->
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryUserDefaults</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array><string>CA92.1</string></array>
		</dict>
	</array>
</dict>
</plist>
